+    // Paper start - Record player hitboxes for hitreg
+    private void setPosition() {
+        if (!this.world.paperConfig.usePreviousPositions) {
+            this.previousPositions.clear();
+            this.previousPositionsWorld = this.world;
+            return;
+        }
+
+        if (this.previousPositionsWorld != this.world) {
+            this.previousPositions.clear();
+            this.previousPositionsWorld = this.world;
+        }
+
+        this.previousPositions.addFirst(this.getBoundingBox());
+        while (this.previousPositions.size() > this.world.paperConfig.savedLocationTicks) {
+            this.previousPositions.removeLast();
+        }
+    }
+
+    @Nullable
+    public Vec3D getPreviousPositionHit(Vec3D start, Vec3D end) {
+        if (this.previousPositionsWorld != this.world) {
+            return null;
+        }
+
+        Vec3D closestHit = null;
+        double closestDistance = Double.MAX_VALUE;
+        for (AxisAlignedBB previousPosition : this.previousPositions) {
+            AxisAlignedBB expandedHitbox = previousPosition.grow((double) this.getCollisionBorderSize());
+            Optional<Vec3D> hit = expandedHitbox.calculateIntercept(start, end);
+            if (!hit.isPresent() && !expandedHitbox.contains(start)) {
+                continue;
+            }
+
+            Vec3D hitPosition = hit.orElse(start);
+            double distance = start.distanceSquared(hitPosition);
+            if (distance < closestDistance) {
+                closestHit = hitPosition;
+                closestDistance = distance;
+            }
+        }
+
+        return closestHit;
+    }
+    // Paper end - Record player hitboxes for hitreg
+
