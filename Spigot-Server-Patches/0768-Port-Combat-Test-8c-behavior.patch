+    SHOVEL,
+    TRIDENT;
+
+    static final UUID BASE_ATTACK_DAMAGE_UUID = UUID.fromString("CB3F55D3-645C-4F38-A497-9C13A33DB5CF");
+    static final UUID BASE_ATTACK_SPEED_UUID = UUID.fromString("FA233E1C-4180-4865-B01B-BCCE9785ACA3");
+    static final UUID BASE_ATTACK_REACH_UUID = UUID.fromString("26cb07a3-209d-4110-8e10-1010243614c8");
+
+    void addCombatAttributes(ToolMaterial toolmaterial, ImmutableMultimap.Builder<AttributeBase, AttributeModifier> builder) {
+        float damage = this.getDamage(toolmaterial);
+        float speed = this.getSpeed(toolmaterial);
+        float reach = this.getReach(toolmaterial);
+
+        builder.put(GenericAttributes.ATTACK_DAMAGE, new AttributeModifier(BASE_ATTACK_DAMAGE_UUID, "Weapon modifier", (double) damage, AttributeModifier.Operation.ADDITION));
+        builder.put(GenericAttributes.ATTACK_SPEED, new AttributeModifier(BASE_ATTACK_SPEED_UUID, "Weapon modifier", (double) speed, AttributeModifier.Operation.ADDITION));
+        if (reach != 0.0F) {
+            builder.put(GenericAttributes.ATTACK_REACH, new AttributeModifier(BASE_ATTACK_REACH_UUID, "Weapon modifier", (double) reach, AttributeModifier.Operation.ADDITION));
+        }
+    }
+
+    float getDamage(ToolMaterial toolmaterial) {
+        switch (this) {
+            case SWORD:
+                return toolmaterial.c() + 2.0F;
+            case AXE:
+                return toolmaterial.c() + 3.0F;
+            case PICKAXE:
+                return toolmaterial.c() + 1.0F;
+            case HOE:
+                if (toolmaterial == EnumToolMaterial.IRON || toolmaterial == EnumToolMaterial.DIAMOND) {
+                    return 1.0F;
+                }
+                return toolmaterial == EnumToolMaterial.NETHERITE ? 2.0F : 0.0F;
+            case SHOVEL:
+                return toolmaterial.c();
+            case TRIDENT:
+                return 5.0F;
+            default:
+                return 0.0F;
+        }
+    }
+
+    float getSpeed(ToolMaterial toolmaterial) {
+        switch (this) {
+            case SWORD:
+                return 0.5F;
+            case AXE:
+            case SHOVEL:
+            case TRIDENT:
+                return -0.5F;
+            case PICKAXE:
+                return 0.0F;
+            case HOE:
+                if (toolmaterial == EnumToolMaterial.WOOD) {
+                    return -0.5F;
+                }
+                if (toolmaterial == EnumToolMaterial.IRON) {
+                    return 0.5F;
+                }
+                if (toolmaterial == EnumToolMaterial.DIAMOND || toolmaterial == EnumToolMaterial.GOLD || toolmaterial == EnumToolMaterial.NETHERITE) {
+                    return 1.0F;
+                }
+                return 0.0F;
+            default:
+                return 0.0F;
+        }
+    }
+
+    float getReach(ToolMaterial toolmaterial) {
+        switch (this) {
+            case SWORD:
+                return 0.5F;
+            case HOE:
+            case TRIDENT:
+                return 1.0F;
+            default:
+                return 0.0F;
+        }
+    }
+}
