From: NotCoded <66999075+not-coded@users.noreply.github.com>
Date: Mon, 22 Jun 2026 19:21:58 +0200
Subject: [PATCH] Backport PersistentDataContainer#copyTo

diff --git a/src/main/java/org/bukkit/craftbukkit/persistence/CraftPersistentDataContainer.java b/src/main/java/org/bukkit/craftbukkit/persistence/CraftPersistentDataContainer.java
index a4c888236bf09a25f234831a041ca5a4a2c972ef..8a428a6fd964b685cdeda1c35788c0248f77a772 100644
--- a/src/main/java/org/bukkit/craftbukkit/persistence/CraftPersistentDataContainer.java
+++ b/src/main/java/org/bukkit/craftbukkit/persistence/CraftPersistentDataContainer.java
@@ -160,5 +160,18 @@ public final class CraftPersistentDataContainer implements PersistentDataContain
     public void clear() {
         this.customDataTags.clear();
     }
+
+    @Override
+    public void copyTo(PersistentDataContainer other, boolean replace) {
+        Validate.notNull(other, "The target container cannot be null");
+        Validate.isTrue(other instanceof CraftPersistentDataContainer, "Cannot copy to a non-CraftPersistentDataContainer");
+
+        CraftPersistentDataContainer target = (CraftPersistentDataContainer) other;
+        for (Entry<String, NBTBase> entry : this.customDataTags.entrySet()) {
+            if (replace || !target.customDataTags.containsKey(entry.getKey())) {
+                target.customDataTags.put(entry.getKey(), entry.getValue().clone());
+            }
+        }
+    }
     // Paper end
 }
