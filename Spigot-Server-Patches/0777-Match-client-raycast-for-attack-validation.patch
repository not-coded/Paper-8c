+    // Paper start - Match client attack raycast for attack validation
+    private boolean matchesClientAttackRaycast(Entity target, double reach) {
+        Vec3D start = this.player.getEyePosition(1.0F);
+        Vec3D direction = this.player.getLookDirection();
+        Vec3D end = start.add(direction.x * reach, direction.y * reach, direction.z * reach);
+        AxisAlignedBB searchBox = this.player.getBoundingBox()
+            .expand(direction.x * reach, direction.y * reach, direction.z * reach)
+            .grow(1.0D, 1.0D, 1.0D);
+
+        Entity closestEntity = null;
+        Vec3D closestHit = null;
+        double closestDistance = Double.MAX_VALUE;
+        for (Entity candidate : this.player.world.getEntities(this.player, searchBox, entity -> !entity.isSpectator() && entity.isInteractable())) {
+            AxisAlignedBB candidateBox = candidate.getBoundingBox().grow((double) candidate.getCollisionBorderSize());
+            Optional<Vec3D> hit = candidateBox.calculateIntercept(start, end);
+            if (!hit.isPresent() && !candidateBox.contains(start)) {
+                continue;
+            }
+
+            Vec3D hitPosition = hit.orElse(start);
+            double distance = start.distanceSquared(hitPosition);
+            if (distance < closestDistance) {
+                closestEntity = candidate;
+                closestHit = hitPosition;
+                closestDistance = distance;
+            }
+        }
+
+        if (closestEntity != target || closestHit == null) {
+            return false;
+        }
+
+        MovingObjectPosition blockHit = this.player.world.rayTrace(new RayTrace(start, closestHit, RayTrace.BlockCollisionOption.COLLIDER, RayTrace.FluidCollisionOption.NONE, this.player));
+        return blockHit.getType() == MovingObjectPosition.EnumMovingObjectType.MISS;
+    }
+    // Paper end - Match client attack raycast for attack validation
+
